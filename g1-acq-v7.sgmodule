#!name=G1 ACQ
#!desc=v7.6.0：支持 Ultra 1个月免费试用，20TB g1.20tb.1month_eft.acq、30TB g1.ai.ultra.1month_eft.acq，各档独立回退三个月90p备用；2TB 12个月优惠测试 g1.2tb.ai.12months_ip_90p（无 .acq）；被动采集原始 SKU，最近10次响应/本次新增/重复诊断；本机报告与 JSON 导出；非主动查询全量 SKU
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/phongdg259/g1-acq@09223c88d690b65b42e47fc235420460d11bab4d/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/phongdg259/g1-acq@09223c88d690b65b42e47fc235420460d11bab4d/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
